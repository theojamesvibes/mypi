# Copy this file to .env and fill in values

# PostgreSQL
POSTGRES_DB=mypi
POSTGRES_USER=mypi
POSTGRES_PASSWORD=changeme

# App
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# Optional: split secrets. When set, JWT_SECRET_KEY is used to sign session JWTs
# and API_KEY_SALT is used to HMAC API keys, in place of SECRET_KEY for that
# specific use. Leave both unset to fall back to SECRET_KEY (default behaviour).
# Rotating one without the other lets you invalidate JWT sessions without
# invalidating API keys, or vice versa.
# JWT_SECRET_KEY=
# API_KEY_SALT=

# Fernet key for encrypting Pi-hole API passwords at rest.
# Auto-generated and saved to the database on first startup if not set here.
# Pin it here for portability (the generated key is logged as a warning on first boot).
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# Set to true if MyPi is behind a TLS-terminating reverse proxy (Traefik, nginx, etc.)
# This adds the Secure flag to session cookies. Leave false for plain HTTP local access.
SECURE_COOKIES=false

# Set to true to verify TLS certificates when connecting to Pi-hole instances over HTTPS.
# Leave false (default) if your Pi-hole uses a self-signed certificate.
VERIFY_PIHOLE_SSL=false

# Initial admin account (created on first startup only if no users exist).
# Username defaults to "admin"; override it here if desired.
#
# Password: leave INITIAL_ADMIN_PASSWORD unset and MyPi generates a random
# password on first boot, logs it ONCE at WARN level, and forces a change on
# first login. Retrieve it with:
#     docker compose logs app | grep -A2 "generated password"
# Or set INITIAL_ADMIN_PASSWORD below to pin a known password instead (a change
# is still forced on first login). It only takes effect on first startup, before
# any user exists.
INITIAL_ADMIN_USER=admin
# INITIAL_ADMIN_PASSWORD=

# Port the dashboard is served on
APP_PORT=8080

# Collection intervals (seconds)
STATS_POLL_INTERVAL=60
QUERIES_POLL_INTERVAL=300

# Days of query history to retain
DATA_RETENTION_DAYS=30

# Expose FastAPI's auto-generated /docs (Swagger UI) and /openapi.json.
# Both are useful in development (and for regenerating the iOS OpenAPI
# client) but reveal the full API surface unauthenticated. Default is
# false — set to true only when you actively need them.
ENABLE_API_DOCS=false

# Per-instance circuit breaker — suspends polling for a wedged Pi-hole
# after N consecutive failures, for M seconds, instead of hammering it
# at the normal cadence.  Failures within the dedup window of the
# previous failure count as the same event (stats+queries share the
# connection).  Defaults match the hard-coded values before 1.8.0-dev.16.
# CIRCUIT_FAIL_THRESHOLD=3
# CIRCUIT_COOLDOWN_SECONDS=300
# CIRCUIT_DEDUP_SECONDS=2.0

# Seconds to pause /api/auth attempts after a 429 from a Pi-hole.  Set
# lower if your fleet has a higher webserver.api.max_sessions and a
# 5-minute blackout is too long.
# AUTH_BACKOFF_SECONDS=300
