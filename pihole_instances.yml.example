# Pi-hole instance configuration for MyPi
# Copy this file to pihole_instances.yml and fill in your instance details.
# Instances are loaded at startup and synced to the database.
# Restart the container to pick up configuration changes.

instances:
  - name: "Living Room"
    url: "http://192.168.1.100"
    password: "your-pihole-password"
    color: "#00a65a"   # green
    master: true       # sync source — exactly one instance should be master

  - name: "Office"
    url: "http://192.168.1.101"
    password: "your-pihole-password"
    color: "#3c8dbc"   # blue

  - name: "Bedroom"
    url: "http://192.168.1.102"
    password: "your-pihole-password"
    color: "#f39c12"   # orange

  # Pi-hole with no password set — omit the field or leave it empty:
  # - name: "Garage"
  #   url: "http://192.168.1.103"
  #   password: ""
  #   color: "#9b59b6"   # purple

  # Dormant VIP secondary (hot spare): fully online and pollable, but
  # receives no DNS traffic while the primary holds the VIP.  Marking it
  # hot_spare: true suppresses sync-failure Pushover alerts from this node
  # (its idle keepalive flap no longer pages you).  It does NOT change the
  # stats-poll offline alert — a hot spare going genuinely unreachable
  # still fires the normal offline notification.
  # - name: "Standby"
  #   url: "http://192.168.1.105"
  #   password: "your-pihole-password"
  #   color: "#95a5a6"   # gray
  #   hot_spare: true

# Up to 10 instances supported.
# Colors are used in charts to distinguish each Pi-hole visually.
#
# password:  corresponds to the Pi-hole web interface password (Pi-hole v6 API).
#            Leave empty ("") or omit entirely for instances with no password set.
# master:    designates the sync source for Pi-hole Sync. Exactly one instance
#            should be marked master: true. Omit or set false on all replicas.
# hot_spare: marks a replica as a dormant VIP secondary. Sync failures on a
#            hot spare (after one in-sync retry) are recorded and shown in the
#            UI but do not fire Pushover. Cannot be combined with master: true.
