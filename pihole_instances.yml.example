# Pi-hole instance configuration for MyPi
# Copy this file to pihole_instances.yml and fill in your details.
# Loaded at startup and synced to the database. Restart the container to
# pick up configuration changes.
#
# Two formats are supported. Pick whichever fits your deployment.

# ==============================================================================
# FORMAT 1 — single-site (legacy; unchanged from previous MyPi releases)
# ==============================================================================
#
# Use this if you have one group of Pi-holes to aggregate. MyPi wraps them
# internally into an implicit "Default" site. No YAML change needed when
# upgrading from earlier MyPi versions.

instances:
  - name: "Living Room"
    url: "http://192.168.1.100"
    password: "your-pihole-password"
    color: "#00a65a"   # green
    master: true       # sync source — exactly one instance should be master

  - name: "Office"
    url: "http://192.168.1.101"
    password: "your-pihole-password"
    color: "#3c8dbc"   # blue

  - name: "Bedroom"
    url: "http://192.168.1.102"
    password: "your-pihole-password"
    color: "#f39c12"   # orange

# Up to 10 instances per site.
# `password:` — Pi-hole v6 web-interface password. Leave empty ("") or
#              omit entirely for no-password Pi-holes.
# `master:` — designates the sync source within the site. Exactly one
#             instance per site should be master.


# ==============================================================================
# FORMAT 2 — multi-site (up to 10 sites, each with up to 10 Pi-holes)
# ==============================================================================
#
# Use this when you run Pi-holes at more than one physical location or want
# independent sync groups. Uncomment the block below and delete the
# `instances:` block above.
#
# Exactly one site should be flagged `default_site: true` — it's the source
# for inherited settings (Pushover, sync schedule, poll intervals) that
# other sites can opt to share via the "Use Main's settings" checkbox in the
# UI. If you don't flag any site as default_site, the first one becomes the
# default. (`main: true` is a silent back-compat alias for the same flag.)
#
# Renaming the default site is supported in-place: change `name:` on the
# `default_site: true` entry and restart. MyPi detects the rename, updates
# the existing site row, preserves all data + history, and adds the old
# URL slug to the redirect history so bookmarks keep working.

# sites:
#   - name: "WTR"
#     default_site: true     # exactly one site should be default_site
#     instances:
#       - name: "pihole1"
#         url: "https://192.168.66.20"
#         password: "..."
#         color: "#00a65a"
#         master: true       # master *within this site*
#       - name: "pihole2"
#         url: "https://192.168.66.21"
#         password: "..."
#         color: "#3c8dbc"
#
#   - name: "Cabin"
#     instances:
#       - name: "Cabin Pi"
#         url: "http://192.168.77.10"
#         password: "..."
#         color: "#f39c12"
#         master: true
#
# ─── Advanced ─────────────────────────────────────────────────────────────────
# The `slug:` field on each site is optional. MyPi derives one from `name:`
# ("Cabin" → "cabin", "Home Base" → "home-base"). The slug appears in URLs
# (`/api/sites/cabin/...`, `/dashboard/cabin`) and in iOS's site picker. Set
# `slug:` explicitly only when the derived one is awkward or when you want
# shorter URLs. Reserved slugs you can't use: `sites`, `inactive`, `admin`,
# `main`.
