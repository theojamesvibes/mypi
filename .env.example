# Copy this file to .env and fill in values

# PostgreSQL
POSTGRES_DB=mypi
POSTGRES_USER=mypi
POSTGRES_PASSWORD=changeme

# App
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# Optional: split secrets. When set, JWT_SECRET_KEY is used to sign session JWTs
# and API_KEY_SALT is used to HMAC API keys, in place of SECRET_KEY for that
# specific use. Leave both unset to fall back to SECRET_KEY (default behaviour).
# Rotating one without the other lets you invalidate JWT sessions without
# invalidating API keys, or vice versa.
# JWT_SECRET_KEY=
# API_KEY_SALT=

# Fernet key for encrypting Pi-hole API passwords at rest.
# Auto-generated and saved to the database on first startup if not set here.
# Pin it here for portability (the generated key is logged as a warning on first boot).
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# Set to true if MyPi is behind a TLS-terminating reverse proxy (Traefik, nginx, etc.)
# This adds the Secure flag to session cookies. Leave false for plain HTTP local access.
SECURE_COOKIES=false

# Set to true to verify TLS certificates when connecting to Pi-hole instances over HTTPS.
# Leave false (default) if your Pi-hole uses a self-signed certificate.
VERIFY_PIHOLE_SSL=false

# Initial admin account (created on first startup if no users exist).
# Default username is "admin", default password is "changeme".
# You will be required to change the password on first login.
# Override the username here if desired — password intentionally has no override.
INITIAL_ADMIN_USER=admin

# Port the dashboard is served on
APP_PORT=8080

# Collection intervals (seconds)
STATS_POLL_INTERVAL=60
QUERIES_POLL_INTERVAL=300

# Days of query history to retain
DATA_RETENTION_DAYS=30

# Expose FastAPI's auto-generated /docs (Swagger UI) and /openapi.json.
# Both are useful in development but reveal the full API surface
# unauthenticated. Set to false if MyPi is reachable from anything
# untrusted.
ENABLE_API_DOCS=true
